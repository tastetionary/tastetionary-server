{
  "name": "taste-dictionary-api",
  "version": "0.5.16",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prebuild": "rimraf dist",
    "postbuild": "npx nestia swagger && node -e \"require('fs').copyFileSync('packages/api/swagger.json', 'dist/swagger.json')\"",
    "swagger": "npx nestia swagger",
    "sdk": "rimraf ./src/api/functional && NODE_ENV=development nestia sdk",
    "nestia": "npm run swagger ; npm run sdk",
    "build:api": "rimraf packages/api/lib && npm run nestia && tsc -p ./tsconfig.api.json",
    "package:publish": "npm run build:api && cd ./packages/api && npm publish --access=public",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "cross-env NODE_ENV=dev nest start --watch",
    "start:test": "cross-env NODE_ENV=test nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "NODE_ENV=test ENV=test jest --runInBand --testPathPattern='/src/'",
    "test:seq": "NODE_ENV=test ENV=test jest --runInBand --testPathPattern='/src/' --bail --forceExit",
    "test:seq:failed": "NODE_ENV=test ENV=test jest --runInBand NODE_ENV=test ENV=test --testPathPattern='/src/' --bail=false --onlyFailures",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "NODE_ENV=test jest --testPathPattern='test/e2e' --forceExit",
    "prepare": "husky install",
    "husky": "npx husky install && npx husky add .husky/pre-commit",
    "postinstall": "ts-patch install"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.804.0",
    "@aws-sdk/s3-request-presigner": "^3.804.0",
    "@fxts/core": "^1.26.0",
    "@nestia/core": "^11.3.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.3",
    "@sendinblue/client": "^3.3.1",
    "@sentry/cli": "^2.21.2",
    "@sentry/node": "^10.65.0",
    "@types/bcrypt": "^5.0.0",
    "@types/multer": "^1.4.12",
    "axios": "^1.18.1",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "discord-webhook-node": "^1.1.8",
    "emoji-regex": "^8.0.0",
    "fp-ts": "^2.16.1",
    "helmet": "^8.2.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.3",
    "nest-winston": "^1.10.2",
    "redis": "^4.7.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "typescript-transform-paths": "^3.5.6",
    "typia": "^12.1.1",
    "uuid": "^11.0.0",
    "winston": "^3.10.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@nestia/e2e": "^11.3.4",
    "@nestia/sdk": "^11.3.4",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@relmify/jest-fp-ts": "^2.1.1",
    "@testcontainers/postgresql": "^12.0.3",
    "@testcontainers/redis": "^12.0.3",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^11.0.0",
    "cooky-cutter": "^1.5.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "husky": "^8.0.3",
    "io-ts": "^2.2.22",
    "jest": "^29.5.0",
    "lint-staged": "^13.2.3",
    "nestia": "^11.3.4",
    "prettier": "^3.0.0",
    "prisma": "^6.19.3",
    "rimraf": "^6.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "testcontainers": "^12.0.4",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "ts-patch": "^3.3.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.62.1"
  },
  "overrides": {
    "@babel/traverse": "^7.29.7",
    "fast-xml-parser": "^4.5.6",
    "handlebars": "^4.7.9",
    "request": {
      "form-data": "^2.5.4"
    },
    "@types/request": {
      "form-data": "^2.5.4"
    },
    "discord-webhook-node": {
      "form-data": "^3.0.4"
    },
    "superagent": {
      "form-data": "^4.0.6"
    },
    "netmask": "^2.0.2",
    "@nestjs/cli": {
      "glob": "^10.5.0"
    },
    "lodash": "^4.18.0",
    "multer": "^2.2.0",
    "picomatch": "^4.0.4",
    "tar": "^7.5.22",
    "tmp": "^0.2.6"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
