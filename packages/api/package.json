{
    "name": "@taehoya/tastetionary",
    "version": "0.5.16",
    "description": "SDK library generated by Nestia",
    "main": "lib/index.js",
    "typings": "lib/index.d.ts",
    "scripts": {
        "package:publish": "npm run build:api && cd ./packages/api && npm publish --access=public",
        "build": "npm run build:sdk && npm run compile",
        "build:sdk": "rimraf ../../src/api/functional && cd ../.. && npx nestia sdk && cd packages/api",
        "compile": "rimraf lib && tsc",
        "deploy": "npm run build && npm publish"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/taehoya/tastetionary-npm"
    },
    "author": "matthew",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/taehoya/tastetionary-npm/issues"
    },
    "homepage": "https://github.com/taehoya/tastetionary-npm",
    "files": [
        "lib",
        "package.json",
        "README.md"
    ],
    "devDependencies": {
        "rimraf": "^5.0.1",
        "typescript": "^5.1.6"
    },
    "dependencies": {
        "@nestia/fetcher": "^1.6.5",
        "typescript-transform-paths": "^3.4.6"
    }
}
