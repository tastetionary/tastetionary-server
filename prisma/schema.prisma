generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id        Int      @id @default(autoincrement())
  nickname  String   @map("nickname") @db.VarChar(128)
  state     String   @map("state") @db.VarChar(16)
  property  Json     @map("property")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([nickname])
  @@index([state])
  @@index([nickname, state])
  @@map("users")
}

model UserTokens {
  id                    Int      @id @default(autoincrement())
  userId                Int      @map("user_id")
  accessToken           String   @map("access_token") @db.VarChar(512)
  refreshToken          String   @map("refresh_token") @db.VarChar(512)
  accessTokenExpiredAt  DateTime @map("access_token_expired_at")
  refreshTokenExpiredAt DateTime @map("refresh_token_expired_at")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([userId, accessToken])
  @@index([userId, refreshToken])
  @@map("user_tokens")
}

model UserAreas {
  id        Int                      @id @default(autoincrement())
  userId    Int                      @map("user_id")
  order     Int                      @map("order") @db.SmallInt
  location  Unsupported("geography")
  createdAt DateTime                 @default(now()) @map("created_at")
  updatedAt DateTime                 @updatedAt @map("updated_at")
  address   String                   @map("address") @db.VarChar(128)

  @@index([userId])
  @@index([location], type: Gist)
  @@map("user_areas")
}

model UserPreferences {
  id                      Int      @id @default(autoincrement())
  userId                  Int      @map("user_id")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  bookmark_restaurant_ids Int[]    @map("bookmark_restaurant_ids")
  exclude_restaurant_ids  Int[]    @map("exclude_restaurant_ids")

  @@index([userId])
  @@index([bookmark_restaurant_ids], type: Gin)
  @@index([exclude_restaurant_ids], type: Gin)
  @@map("user_preferences")
}

model RestaurantReviews {
  id                                 Int      @id @default(autoincrement())
  userId                             Int      @map("user_id")
  category                           String   @map("category") @db.VarChar(32) /// 리뷰시 등록되는 음식 종류, 한식 중식 양식 등
  summary                            String   @map("summary") @db.VarChar(128) /// 한줄 요약
  opinion                            String?  @map("opinion") @db.VarChar(16) // 최종 의견, 
  keywords                           String[] @map("keywords") @db.Text // tags
  price                              Int      @map("price") @db.Integer // 가격
  like                               Int      @default(0) @map("like") @db.Integer // 좋아요
  dislike                            Int      @default(0) @map("dislike") @db.Integer // 싫어요
  createdAt                          DateTime @default(now()) @map("created_at")
  updatedAt                          DateTime @updatedAt @map("updated_at")
  /// 외부 API 를 통해 가져온 식당 uuid
  external_restaurant_information_id BigInt   @map("external_restaurant_information_id")

  @@index([userId])
  @@index([external_restaurant_information_id])
  @@index([external_restaurant_information_id, userId])
  @@index([keywords], type: Gin)
  @@index([price])
  @@map("restaurant_reviews")
}

model ExternalRestaurantInformations {
  id             BigInt                   @id @default(autoincrement())
  external_uuid  BigInt                   @unique @map("external_uuid")
  location       Unsupported("geography")
  reference_link String                   @map("reference_link") @db.VarChar(1024)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  name           String                   @map("name") @db.VarChar(128)

  @@index([external_uuid])
  @@index([location], type: Gist)
  @@map("external_restaurant_informations")
}

model Accounts {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  category       String   @map("category") @db.VarChar(32)
  identification String   @map("identification") @db.VarChar(256)
  password       String   @map("password") @db.VarChar(256)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([category, identification])
  @@index([userId])
  @@index([category, identification])
  @@index([identification, password])
  @@map("accounts")
}

model Agreements {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  category  String   @map("category") @db.VarChar(32)
  is_agree  Boolean  @map("state")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([userId, category])
  @@map("agreements")
}

model Authentications {
  id             Int      @id @default(autoincrement())
  userId         Int?     @map("user_id")
  identification String   @map("identification") @db.VarChar(256)
  category       String   @map("category") @db.VarChar(32)
  type           String   @map("type") @db.VarChar(16)
  state          String   @map("state") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([identification, category])
  @@index([userId])
  @@index([identification])
  @@index([userId, category])
  @@index([userId, category, type, state])
  @@index([userId, identification, category, type])
  @@index([identification, category, type])
  @@map("authentications")
}

model AuthenticationHistories {
  id             Int      @id @default(autoincrement())
  identification String   @map("identification") @db.VarChar(256)
  type           String   @map("type") @db.VarChar(16)
  code           String   @map("code") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  expiredAt      DateTime @map("expired_at")
  category       String   @map("category") @db.VarChar(32)

  @@index([identification, category, type])
  @@index([identification, category, type, code])
  @@map("authentication_histories")
}

model UserOpinions {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  /// 의견 수집 이벤트, 탈퇴시, 가입시 등
  category  String   @map("category") @db.VarChar(32)
  /// 의견 1차 분류
  type      String   @map("type") @db.VarChar(64)
  /// 상세의견
  opinion   String?  @map("opinion") @db.VarChar(1024)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, category])
  @@index([userId])
  @@index([category])
  @@index([type])
  @@index([category, type])
  @@map("user_opinions")
}

model ReviewReports {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  reviewId  Int      @map("review_id")
  category  String   @map("category") @db.VarChar(32)
  content   String   @map("content") @db.VarChar(1024)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([reviewId])
  @@index([category])
  @@index([userId, reviewId])
  @@index([userId, category])
  @@index([reviewId, category])
  @@map("review_reports")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}
