
### Register User , full auth
POST {{base_url}}/v1/user
Content-Type: {{content_type_json}}

{
  "userProperty": {
    "company": {
      "authenticationId": 286,
      "companyName": "matthew-test",
      "identification": "wkdgndldi@naver.com",
      "category": "email"
    }
  },
  "areas": [
    {
      "latitude": 37.48913764364786,
      "longitude": 127.0311629855974,
      "category": "activity_area",
      "address": "activity"
    },
    {
      "latitude": 37.48913764364786,
      "longitude": 127.0311629855974,
      "category": "dining_area",
      "address": "dining"
    }
  ],
  "account": {
    "authenticationId": 285,
    "identification": "wkdgndldi@naver.com",
    "password": "pwd",
    "category": "email"
  },
  "agreements": [
    {
      "category": "personal_information",
      "is_agree": true
    }
  ]
}

