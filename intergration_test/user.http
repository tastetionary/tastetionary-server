### get token(use after register user)
# @name token
post {{base_url}}/v1/account/tokens
content-type: {{content_type_json}}

{
  "identification": "wkdgndldi@naver.com",
  "password": "pwd",
  "category": "email"
}

###
@access_token = {{token.response.body.data.accessToken}}


### get profile 
GET {{base_url}}/v1/user
Authorization: Bearer {{access_token}}
Content-Type: {{content_type_json}}

### modify user area
PUT {{base_url}}/v1/user
Authorization: Bearer {{access_token}}
Content-Type: {{content_type_json}}

{
      "latitude": 100,
      "longitude": 100,
      "category": "activity_area",
      "address":"activity-update"
}

### delete user
DELETE  {{base_url}}/v1/user
Authorization: Bearer {{access_token}}
Content-Type: {{content_type_json}}

{
  "type":"inconvenient_usage"
}
