
### Register User 
POST {{base_url}}/v1/user
Content-Type: {{content_type_json}}

{
  "userProperty": {
    "companyName": "test"
  },
  "areas": [
    {
      "latitude": 1,
      "longitude": 1,
      "category": "activity_area",
      "address":"activity"
    },
    {
      "latitude": 1,
      "longitude": 1,
      "category": "dining_area",
      "address":"dining"
    }
  ],
  "account": {
    "identification": "matthew-1022",
    "password": "pwd",
    "category": "email"
    
  },
  "agreements": [
    {
      "category": "personal_information",
      "is_agree": true
    }
  ]
}


### get token(use after register user)
# @name token
post {{base_url}}/v1/account/tokens
content-type: {{content_type_json}}

{
  "identification": "matthew-1022",
  "password": "pwd",
  "category": "email"
}

###
@access_token = {{token.response.body.data.accessToken}}
### Register User 
PUT {{base_url}}/v1/user
Authorization: Bearer {{access_token}}
Content-Type: {{content_type_json}}

{
      "latitude": 100,
      "longitude": 100,
      "category": "activity_area",
      "address":"activity-update"
}