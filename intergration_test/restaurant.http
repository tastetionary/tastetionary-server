### get token(use after register user)
# @name token
post {{base_url}}/v1/account/tokens
content-type: {{content_type_json}}

{
  "identification": "backend-1@naver.com",
  "password": "qordpsem1!",
  "category": "email"
}

###
@access_token = {{token.response.body.data.accessToken}}

### Register review
POST {{base_url}}/v1/restaurant/review
Authorization: Bearer {{access_token}}
Content-Type: {{content_type_json}}

{
    "review":{
        "category":"일식",
        "keywords":["양이 많아요🥰"],
        "price":13000,
        "summary":"one-line summary",
        "opinion":"Y"
    },
    "external":{
        "externalUUID": 9657256,
        "name": "구찌라쿠",
        "referenceLink": "http://place.map.kakao.com/9657256",
        "latitude": 37.4873289576785,
        "longitude": 127.103138388805
    }
}

### get recommenda tion
POST {{base_url}}/v1/restaurant/recommendation
Authorization: Bearer {{access_token}}
Content-Type: {{content_type_json}}

{
    "category":"일식",
    "keywords":["분위기 좋아요🍷"],
    "price":14000,
    "excludeIds":[]
}